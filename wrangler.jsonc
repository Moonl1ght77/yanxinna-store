{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yanxinna-store-cms-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // 运行时变量。敏感值不放这里：WORDPRESS_REVALIDATE_SECRET 用
  // `npx wrangler secret put WORDPRESS_REVALIDATE_SECRET` 单独设置。
  // 2026-08-03 起指向正式 WordPress 主机（阿里云香港 47.243.151.206），
  // cloudflared 临时隧道方案已退役。
  "vars": {
    "WORDPRESS_API_URL": "https://cms.yanxinna.com/wp-json/yanxinna/v1",
    "NEXT_PUBLIC_SITE_URL": "https://yanxinna.com"
  },
  // 2026-08-03 绑定正式域名。custom_domain 会自动在 Cloudflare 区域里建 DNS 记录，
  // 不要再手工加 yanxinna.com 的 A/CNAME，会冲突。
  "routes": [
    { "pattern": "yanxinna.com", "custom_domain": true }
  ],
  // OpenNext 的缓存后端。没有这两个绑定，Next 的 fetch 缓存和 revalidateTag
  // 在 Cloudflare 上完全不生效，每次请求都会回源打 WordPress。
  // 本地 `wrangler dev` 用 miniflare 模拟，不会碰到真实命名空间。
  // 下面是 2026-07-24 在账号 d9cd5ff6…（liltrick1015@gmail.com）下创建的真实 id，
  // 重建命令：
  //   npx wrangler kv namespace create yanxinna-inc-cache
  //   npx wrangler kv namespace create yanxinna-tag-cache
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "2eea2823fcc04e3bb6b5384f40157635"
    },
    {
      "binding": "NEXT_TAG_CACHE_KV",
      "id": "b4ad4925d5ae49199f641725e5dca1d1"
    }
  ]
}
